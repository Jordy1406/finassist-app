# Copy to .env and adjust. Never commit .env.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
REQUEST_TIMEOUT_S=120

# Ingest / RAG
EMBED_MODEL=nomic-embed-text
DOCS_DIR=docs
INDEX_PATH=data/index.json
CHUNK_MAX_WORDS=300
CHUNK_MAX_WORDS_LAW=400
CHUNK_OVERLAP_WORDS=50
TOP_K=4
MIN_SCORE=0.5
NUM_CTX=8192

# Agent (/agent)
AGENT_PROVIDER=ollama          # ollama (dev) | anthropic (final runs; needs ANTHROPIC_API_KEY)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
AGENT_MAX_STEPS=6
BROKER_ALWAYS_OPEN=false       # true = ignore market hours (demos at night)
# ANTHROPIC_API_KEY=            # set in .env only, never commit
